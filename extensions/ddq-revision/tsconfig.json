{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/extension.ts",
    "src/ddq/**/*.ts",
    "src/tagging/**/*.ts",
    "src/revision/**/*.ts"
  ],
  "exclude": [
    "src/webview/**",
    "node_modules",
    "out"
  ]
}
