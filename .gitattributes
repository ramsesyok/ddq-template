# ビルドに使うテキストは LF に統一しておく。
# 設計書リポジトリへ配布する機構ファイル（css / json を含む）は、両側で改行が
# 揃っていないと「発行者が setup を走らせるたびに差分が出る」ため、必ず LF にする。
*.js text eol=lf
*.lua text eol=lf
# 開発用スクリプト（cli/tools）。shebang を持つので LF にする。
*.py text eol=lf
# Rust のソースと設定（rustfmt / clippy を Linux の CI でも同じ結果にする）。
*.rs text eol=lf
*.toml text eol=lf
*.typ text eol=lf
*.css text eol=lf
*.json text eol=lf
# PlantUML の共通設定（機構ファイル）。上と同じ理由で LF にする。
*.puml text eol=lf
VERSION text eol=lf
# VSCode 拡張（extension/）のソース。CI は Ubuntu でも走るので LF に揃える。
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.mjs text eol=lf
# ddq が書いた改訂ファイル（拡張の往復テストの golden）。ddq は LF で書くので、
# CRLF に変換されると「書き戻すと同じ文字列になる」検査が Windows だけ落ちる。
*.golden.yml text eol=lf
