{
  "name": "ddq-table-editor",
  "displayName": "DDQ Table Editor",
  "description": "Visual editor for the unified table syntax (::: {.tbl}) of design-doc-quarto-template (ddq)",
  "version": "2.2.1",
  "publisher": "ramsesyok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramsesyok/ddq-template",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "preview": true,
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "ddqTableEditor.open",
        "title": "Open Table Editor",
        "category": "DDQ Table Editor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ddqTableEditor.open",
          "when": "editorTextFocus && (resourceExtname == .qmd || resourceExtname == .md)",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:webview": "vite build",
    "build": "npm run build:ext && npm run build:webview",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json",
    "check:offline": "node scripts/check-offline.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=low",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:offline && npm run check:audit",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
