# 注意: .gitignore ではインライン（行末）コメント不可。コメントは必ず行頭に置く。
# 執筆フォルダ（docs/manual・docs/design・examples/docs・examples/plantuml）は増減・改名するので、
# パターンはフォルダ名に依存させず「名前」でマッチさせる。実体が template/ にある機構ファイルは末尾で除外解除する。

# ==== ビルド生成物 ====
_book/
design-doc.pdf
# Quarto の keep-typ 中間ファイル（通常は自動削除）
index.typ

# 保守リポジトリでは機構の写しは ddq update で作る。
/docs/*/_extensions/ddq/
/examples/*/_extensions/ddq/
/migration/docs/_extensions/ddq/

# 既存の作業コピーに残る旧配置の生成物。
/docs/*/design-doc.lua
/docs/*/design-doc.css
/docs/*/postprocess-html.js
/docs/*/mermaid-config.json
/docs/*/plantuml-config.puml
/docs/*/.template-version
/docs/*/lib.typ
/docs/*/typst-*.typ
/docs/*/_quarto-publish.yml
/examples/*/design-doc.lua
/examples/*/design-doc.css
/examples/*/postprocess-html.js
/examples/*/mermaid-config.json
/examples/*/plantuml-config.puml
/examples/*/.template-version
/examples/*/lib.typ
/examples/*/typst-*.typ
/examples/*/_quarto-publish.yml

# ==== ツールの作業/キャッシュディレクトリ ====
.quarto/
**/*.quarto_ipynb
# Quarto が執筆フォルダ直下に自動生成する .gitignore（中身は /.quarto/）。
# 執筆フォルダは docs/<名前>（設計リポジトリ）と examples/<名前>（サンプル）にあるので、
# 深さ 2 のものを無視し（3 は将来の入れ子用）、ルートの .gitignore は残す。
/*/.gitignore
/*/*/.gitignore
/*/*/*/.gitignore

# ==== mermaid / PlantUML 変換キャッシュ（内容ハッシュ名 mmd-xxxx.* / puml-xxxx.*） ====
# diagrams/order-flow.* は同梱するため無視しない。
**/diagrams/mmd-*
**/diagrams/puml-*

# ==== ページ目視確認用の一時画像（chk-*.png / page-*.png など） ====
chk-*.png
page-*.png

# ==== 配布スナップショット（配布時に作り直す） ====
*.zip
# make-release の出力先（既定）
/release/

# ==== 移行支援スクリプト（migration/）====
__pycache__/
*.pyc

# ==== OS / エディタ ====
.DS_Store
Thumbs.db
*~

# ==== ddq（cli/）のビルド生成物 ====
# cli/.gitignore はルートの /*/.gitignore 規則で無視されるので、ここに書く。
cli/target/

# ==== ddq 移行の回帰確認の採取物（cli/tools/regress.py。作り直せる） ====
regress/

# ==== VSCode 拡張（extensions/<拡張>/）のビルド生成物 ====
# 各拡張の .gitignore は上の /*/.gitignore 規則では拾えない位置にあるので、ここに書く。
# *.vsix はリリース時に ddq-release（保守者用）が各拡張に作り、zip の隣（リリースページの別資産）へコピーする。
extensions/*/node_modules/
cli/tools/mermaid-bundle/node_modules/
extensions/*/out/
# @vscode/test-electron が取得する検証用の VSCode（開発時のみ。配布物には入らない）
extensions/*/.vscode-test/
# ddq-release が同梱用にコピーする、配る ddq.exe（ddq-template の bin/win32-x64/ddq.exe）
extensions/*/bin/
# 同じく同梱用にコピーする第三者のライセンス表示（実体はリポジトリ直下の THIRD-PARTY-NOTICES.md）
extensions/*/THIRD-PARTY-NOTICES.md
*.vsix

# ==== リリースに同梱する外部バイナリ（cli/vendor/README.md。17MB あるので git 管理外） ====
cli/vendor/*.jar
